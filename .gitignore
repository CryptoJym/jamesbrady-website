# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Client-name denylist (geo-seo-spec §9-C: the live list is GITIGNORED).
#
# The gate reads .seo-denylist.txt and that name is ignored HERE, so a real
# client list can never be committed by accident. The committed artifact is
# .seo-denylist.example.txt, which carries the placeholder marker and no
# terms. CI copies the example into place when the CLIENT_DENYLIST secret is
# absent — and in CI mode that path fails the run, it does not pass.
.seo-denylist.txt
.seo-denylist.local.txt
